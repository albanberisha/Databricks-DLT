def get_index(dir):
    try:
        files = [f for f in dbutils.fs.ls(dir) if not f.name.endswith('/')]
        if files:
            file = max(files, key=lambda x: x.name).name
            return int(file.split('.')[0]) + 1
        return 1
    except:
        return 1

# COMMAND ----------

def set_current_catalog(catalog_name):
    spark.sql(f"USE CATALOG {catalog_name}")

